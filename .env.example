# ============================================
# 工时管理系统 - 环境变量配置
# ============================================
# 使用说明：
#   1. 复制本文件为 .env.local (cp .env.example .env.local)
#   2. 替换下面的占位符为你自己的 Supabase 项目凭证
#   3. 启动应用前请确保所有必填项已配置

# ---- Supabase 数据库连接（必填） ----
# 前往 https://supabase.com 注册并创建项目
# 在 Project Settings → API 中可找到以下信息
COZE_SUPABASE_URL=https://your-project-ref.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- JWT 密钥（必填） ----
# 用于会话签名，请使用强随机字符串
# 可使用命令生成：openssl rand -base64 32
JWT_SECRET=please-replace-with-a-strong-random-string

# ---- 服务端口（可选） ----
# 默认 5000，如需修改取消注释并改值
DEPLOY_RUN_PORT=5000

# ---- 可选：AI 功能配置 ----
# 如需启用 AI 工作总结功能，配置外部 AI 服务
# AI_PROVIDER=builtin          # builtin=内置规则引擎, external=外部AI
# AI_API_ENDPOINT=https://api.deepseek.com
# AI_API_KEY=your-ai-api-key
# AI_MODEL=deepseek-chat

# ---- 可选：直接数据库连接（用于自动建表/自动迁移，强烈建议配置） ----
# 配置后应用可自动执行建表与迁移，无需在 Supabase SQL Editor 手动跑 SQL。
# 请使用 Supabase 的 Session pooler 连接串（走 IPv4，本地/家庭网络可达；
# 而 db.<ref>.supabase.co 直连多为 IPv6-only，本机常连不上）。
# 获取方式：Supabase Dashboard → 顶部 "Connect" → ORMs / Session pooler，复制形如：
#   postgresql://postgres.<project-ref>:<数据库密码>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 注意：<数据库密码> 是你创建 Supabase 项目时设置的数据库密码，不是 service_role key。
# DATABASE_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- 可选：周报附件存储后端（默认 local，零配置） ----
# STORAGE_DRIVER=local          # local=本地 public/uploads；s3/r2/minio=S3 兼容
# 配置 S3 兼容（R2/MinIO/AWS S3）时需补全以下变量：
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # MinIO: http://localhost:9000
# S3_REGION=auto                                            # R2 用 auto；MinIO 用 us-east-1
# S3_BUCKET=your-bucket
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_PUBLIC_URL=https://cdn.example.com                     # 公开访问前缀
